# Salin file ini menjadi .env, lalu isi dengan akun khusus QA staging.
LEGAL_BASE_URL=https://sitedev-legal.pgindonesia.com
LEGAL_USERNAME_ROLE_SUPERADMIN=
# Variabel historis VP saat ini dipakai untuk role backend `wakil_direktur`.
LEGAL_USERNAME_ROLE_VP=
LEGAL_USERNAME_ROLE_GENERAL_MANAGER=
LEGAL_USERNAME_ROLE_SVP_LEGAL=
LEGAL_USERNAME_ROLE_ADMIN_LEGAL=
LEGAL_USERNAME_ROLE_STAFF_FINANCE=
LEGAL_PASSWORD=

# Setiap credential positif divalidasi terhadap role backend target. Akun yang
# bisa login tetapi memegang role lain tetap dianggap salah konfigurasi.

# Opsional. Local default memakai Google Chrome yang sudah terpasang.
PLAYWRIGHT_CHANNEL=chrome

# Cabang referensi untuk export riwayat pembayaran. Harus memiliki riwayat.
LEGAL_EXPORT_BANNER_BRANCH_CODE=GGP001

# Pengaman test mutating. Aktifkan hanya jika memang ingin membuat memo staging.
LEGAL_ALLOW_MEMO_CREATE=false

# Pengaman khusus pembuatan Penerima dan Instansi di staging.
LEGAL_ALLOW_MASTER_DATA_CREATE=false

# Pengaman E2E: membuat, approve/reject, membayar, dan menutup memo staging.
LEGAL_ALLOW_E2E_WORKFLOW=false

# Pengaman test yang sengaja meninggalkan memo pada antrean approval.
LEGAL_ALLOW_WAITING_APPROVAL=false
